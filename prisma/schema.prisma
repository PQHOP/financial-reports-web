// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Industry {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  companies Company[]
  createdAt DateTime  @default(now())
}

model Company {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  ticker     String?
  country    String
  exchange   String?
  industries Industry[]
  reports    Report[]
  createdAt  DateTime   @default(now())
}

enum ReportOrigin {
  // Written by us (Claude via the admin UI / scripts). The default view.
  ADMIN
  // Submitted by a visitor through /companies/<slug>/write.
  COMMUNITY
}

enum ReportStatus {
  PENDING
  PUBLISHED
}

enum ReportPeriod {
  Q1
  Q2
  Q3
  Q4
  H1
  ANNUAL
}

model Report {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  year           Int
  period         ReportPeriod
  title          String
  summary        String
  contentMd      String
  coverImageUrl  String?
  author         String       @default("Claude")
  // Link to the primary filing on SEC EDGAR (or the company's IR page).
  sourceUrl      String?
  // Structured headline figures — see src/lib/metrics.ts for the shape.
  metrics        Json?
  // Set by the social cron once the report has been announced.
  socialPostedAt DateTime?
  origin         ReportOrigin @default(ADMIN)
  // Community submissions start PENDING until an admin approves them (see
  // src/lib/community.ts). Everything else is PUBLISHED.
  status         ReportStatus @default(PUBLISHED)
  // Community authors only, never shown publicly: contact address for the
  // admin. "" for system reports. Lower-cased. It is part of the unique key
  // below so the system gets one report per period and each community author
  // gets one per period (NULLs would be distinct in Postgres, hence "").
  authorEmail    String       @default("")
  // sha256(ip + secret) of the submitter, used only to rate-limit.
  submitterHash  String?
  publishedAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([companyId, year, period, authorEmail])
  @@index([origin, status, publishedAt])
  @@index([submitterHash, publishedAt])
}

enum ArticleKind {
  GUIDE
  PREVIEW
  COMPARISON
  SCORECARD
  // Daily automated market brief (see src/lib/newsBrief.ts).
  NEWS
  // Weekly roundup of the week's reports and briefs (see src/lib/weeklyDigest.ts).
  DIGEST
}

// Editorial pieces that aren't a single company-period report: evergreen
// guides, earnings previews, two-company comparisons, sector scorecards.
model Article {
  id          String      @id @default(cuid())
  slug        String      @unique
  kind        ArticleKind
  title       String
  summary     String
  contentMd   String
  // Tickers the piece is about, for internal linking (may be empty).
  tickers     String[]
  publishedAt DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([kind, publishedAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

// Data behind /economy, refreshed daily by /api/cron/macro. One row per data
// set: "weo" (IMF annual values) and "live" (latest monthly/daily figures).
model MacroSnapshot {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}
