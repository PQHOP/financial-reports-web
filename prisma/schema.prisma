// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Industry {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  companies Company[]
  createdAt DateTime  @default(now())
}

model Company {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  ticker     String?
  country    String
  exchange   String?
  industries Industry[]
  reports    Report[]
  createdAt  DateTime   @default(now())
}

enum ReportPeriod {
  Q1
  Q2
  Q3
  Q4
  H1
  ANNUAL
}

model Report {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  year          Int
  period        ReportPeriod
  title         String
  summary       String
  contentMd     String
  coverImageUrl String?
  author        String       @default("Claude")
  publishedAt   DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([companyId, year, period])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}
